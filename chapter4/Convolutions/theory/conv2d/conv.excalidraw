      "isDeleted": false,
      "boundElements": [
        {
          "id": "57-62bKFRZDTj3f3Mu7QJ",
          "type": "arrow"
        }
      ],
      "updated": 1771782151211,
      "link": null,
      "locked": false,
      "text": "Tensores, são estruturas que generalizam \no conceito de vetores e matrizes com um\nnúmero arbitrário de eixos. ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Tensores, são estruturas que generalizam \no conceito de vetores e matrizes com um\nnúmero arbitrário de eixos. ",
      "autoResize": true,
      "lineHeight": 1.25
    },
