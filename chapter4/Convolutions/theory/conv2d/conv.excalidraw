    {
      "id": "-tgv2uPBg3fgwBUznPUR5",
      "type": "text",
      "x": 1874.423376821704,
      "y": -574.8312983681616,
      "width": 623.5594482421875,
      "height": 475,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
