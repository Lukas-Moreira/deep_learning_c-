    },
    {
      "id": "8Bta8z3FqAvHdrCV8_sda",
      "type": "text",
      "x": 2064.4052229563995,
      "y": 460.2072443792246,
      "width": 720.4193115234375,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "9PMo5mxFkXkFGDHmLh8Qp"
      ],
      "frameId": null,
      "index": "aH",
      "roundness": null,
      "seed": 107995007,
      "version": 403,
      "versionNonce": 189067967,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1771782111695,
      "link": null,
      "locked": false,
      "text": "Colocar um padding significa adicionar coeficientes artificiais ao redor da \nmatriz de entrada para evitar a diminuição da matriz de saída.\n\nDessa forma a saída de uma entrada de (6,6) com padding 1 é:\n\n    - dim(output) = (8 - 3 + 1, 8 - 3 + 1) = (6,6)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Colocar um padding significa adicionar coeficientes artificiais ao redor da \nmatriz de entrada para evitar a diminuição da matriz de saída.\n\nDessa forma a saída de uma entrada de (6,6) com padding 1 é:\n\n    - dim(output) = (8 - 3 + 1, 8 - 3 + 1) = (6,6)",
      "autoResize": true,
      "lineHeight": 1.25
    },
